---
interface Project {
	title: string;
	description: string;
	category: string;
	image: string;
	imageAlt: string;
}

const { projects } = Astro.props as { projects: Project[] };
---

<div id="project-rail" class="project-rail" role="region" aria-label="Selected projects" tabindex="0">
	{projects.map((project, index) => (
		<article class="project-item">
			<div class="project-image-wrap">
				<img
					src={project.image}
					alt={project.imageAlt}
					width="1200"
					height="850"
					loading={index === 0 ? "eager" : "lazy"}
				/>
				<span class="project-number">0{index + 1}</span>
			</div>
			<div class="project-copy">
				<p class="project-category">{project.category}</p>
				<h3>{project.title}</h3>
				<p>{project.description}</p>
			</div>
		</article>
	))}
</div>

<script>
	const rail = document.querySelector<HTMLElement>(".project-rail");
	const controls = document.querySelectorAll<HTMLButtonElement>("[data-project-scroll]");

	function updateControls() {
		if (!rail) return;
		const maxScroll = rail.scrollWidth - rail.clientWidth;
		controls.forEach((control) => {
			const direction = Number(control.dataset.projectScroll);
			control.disabled = direction < 0 ? rail.scrollLeft <= 1 : rail.scrollLeft >= maxScroll - 1;
		});
	}

	controls.forEach((control) => {
		control.addEventListener("click", () => {
			if (!rail) return;
			const direction = Number(control.dataset.projectScroll);
			rail.scrollBy({
				left: direction * rail.clientWidth * 0.8,
				behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
			});
		});
	});

	rail?.addEventListener("scroll", updateControls);
	window.addEventListener("resize", updateControls);
	updateControls();
</script>